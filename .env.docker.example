# ─── AncestorTree — Docker self-host environment ────────────────────────────
# Copy to `.env` next to docker-compose.yml and fill in real values.

# Baked into the JS bundle at image build time (build args):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_CLAN_NAME=Họ ...
NEXT_PUBLIC_CLAN_FULL_NAME=Dòng họ ...
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Runtime-only (server-side, not baked in):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=random-long-string

# When the public URL points to localhost, give the container a reachable host:
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
