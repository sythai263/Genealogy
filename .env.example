# ─── AncestorTree — Environment Configuration ─────────────────────────────
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.

# ─── Supabase (required) ───────────────────────────────────────────────────
# Supabase Dashboard → Settings → API  (or `supabase status` for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Clan branding (optional) ──────────────────────────────────────────────
NEXT_PUBLIC_CLAN_NAME=Họ ...
NEXT_PUBLIC_CLAN_FULL_NAME=Dòng họ ...

# ─── Site URL (SEO / sitemap, optional) ────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://giapha.example.com

# ─── Local development flag (optional) ─────────────────────────────────────
# NEXT_PUBLIC_LOCAL_DEV=true

# ─── Cron (required for /api/cron on Vercel) ────────────────────────────────
# Bearer secret checked by requireCronSecret. Generate a random string.
# CRON_SECRET=random-long-string

# ─── Docker / self-host only ────────────────────────────────────────────────
# Internal Supabase URL reachable from inside the container (when the public
# URL is localhost). Example for local Supabase CLI: http://host.docker.internal:54321
# SUPABASE_INTERNAL_URL=
# Directory inside the container where backup ZIPs are also persisted.
# BACKUP_DIR=/data/backups

# ─── Debug (dev only) ───────────────────────────────────────────────────────
# DEBUG_AUTH=true
# MIDDLEWARE_LOG=true
